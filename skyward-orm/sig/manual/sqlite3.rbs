# The collection's signatures leave out the errors, whose extended result codes
# classify a violation, extended_result_codes=, which turns those codes on,
# busy_handler_timeout=, which waits on a lock without holding the GVL,
# execute2, which returns a result's column names, execute_batch, which runs a
# migration, transaction_active? and close, with which the pool finds a
# connection that comes back mid-transaction, and closes one it can't roll back,
# and prepare and the Statement it returns, which a connection keeps to run again.
module SQLite3
  class Exception < ::StandardError
    def code: () -> Integer
  end

  class ConstraintException < Exception
  end

  class Database[ResultType]
    def extended_result_codes=: (bool enabled) -> void
    def busy_handler_timeout=: (Integer milliseconds) -> void
    def execute2: (String sql, *untyped bind_vars) -> Array[Array[untyped]]
    def execute_batch: (String sql) -> void
    def transaction_active?: () -> bool
    def prepare: (String sql) -> Statement
    def close: () -> void
  end

  class Statement
    def bind_params: (*untyped bind_vars) -> void
    def to_a: () -> Array[Array[untyped]]
    def column_count: () -> Integer
    def column_name: (Integer index) -> String
    def reset!: () -> void
    def close: () -> void
  end
end
