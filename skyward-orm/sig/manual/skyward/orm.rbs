module Skyward::ORM
  # Column types Steep reads as their base type, and Skyward ORM as the SQL
  # type a column of them stores.
  type uuid = String
  type int32 = Integer
  type int16 = Integer

  # Each adapter's connection: SQLite3::Database, and Adapters::PostgreSQL::Connection.
  interface _Connection
    def execute: (String sql, ?Array[untyped] binds) -> Array[Array[untyped]]
    # Its first row is the result's column names, even when it has no rows.
    def execute2: (String sql, *untyped binds) -> Array[Array[untyped]]
    def execute_batch: (String sql) -> void
    # The rows the latest INSERT, UPDATE or DELETE that execute ran changed.
    def changes: () -> Integer
    def transaction_active?: () -> bool
    def close: () -> void
  end

  # What Skyward.connect's instrument: takes: a lambda with a &block
  # parameter, or an object. The block runs the statement and returns how
  # many milliseconds it took.
  interface _Instrument
    def call: (Execution execution) { () -> Float } -> void
  end

  # Everything that differs between databases: Adapters::SQLite and Adapters::PostgreSQL.
  interface _Adapter
    def driver: () -> String
    # The adapter as each Execution names it.
    def adapter_name: () -> Symbol
    def connect: (String location) -> _Connection
    def pool_size: (String location, Integer size) -> Integer
    def placeholder: (Integer position) -> String
    def bind_limit: () -> Integer
    def unlimited: () -> String?
    def sql_type: (Tables::column_type type) -> String?
    def identity: () -> String?
    def alters_in_place?: () -> bool
    def default_expression: (String expression) -> String
    def compatible?: (Tables::column_type type, String sql_type) -> bool
    def encode: (untyped value) -> untyped
    def decode: (Tables::column_type type, untyped value) -> untyped
    def tables: (_Connection connection) -> Array[Catalog::Table]
    def violation: (StandardError error, Array[Catalog::Table] tables, Symbol? table) -> Violation?
    # Begins a migration's transaction, first taking a lock that one migrator
    # holds at a time and that ending the transaction releases.
    def begin_migration: () -> String
    # Each row the migration left referring to a missing one, before it
    # commits. None on a database that enforces foreign keys as it goes.
    def foreign_key_violations: (_Connection connection) -> Array[String]
    # Undoes what begin_migration set on the connection, once the transaction
    # has ended, unless it set nothing.
    def end_migration: () -> String?
  end

  # A class whose rows Skyward.query returns: a Data class, a table class, or
  # any class built from keyword arguments.
  interface _Row[T]
    def new: (?) -> T
  end
end
