module Skyward::ORM
  # Each adapter's driver connection: SQLite3::Database, and PostgreSQL's.
  interface _Connection
    def execute: (String sql, ?Array[untyped] binds) -> Array[Array[untyped]]
  end

  # Everything that differs between databases. Adapters::SQLite, and PostgreSQL's.
  interface _Adapter
    def driver: () -> String
    def connect: (String location) -> _Connection
    def pool_size: (String location, Integer size) -> Integer
    def placeholder: (Integer position) -> String
    def sql_type: (Tables::column_type type) -> String?
    def identity: () -> String?
    def default_expression: (String expression) -> String
    def compatible?: (Tables::column_type type, String sql_type) -> bool
    def encode: (untyped value) -> untyped
    def decode: (Tables::column_type type, untyped value) -> untyped
    def tables: (_Connection connection) -> Array[Catalog::Table]
    def violation: (StandardError error, Array[Catalog::Table] tables, Symbol table) -> Violation?
  end
end
