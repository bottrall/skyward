module ChangesFixtures
  class Owner < ::Skyward::ORM::Record
    attr_reader id: Integer
    attr_reader name: String
  end

  class CheckedOwner < ::Skyward::ORM::Record
    attr_reader id: Integer
    attr_reader name: String
  end

  class Item < ::Skyward::ORM::Record
    attr_reader id: Integer
    attr_reader owner_id: Integer
    attr_reader title: String
    attr_reader code: String
    attr_reader status: :open | :closed
    attr_reader note: String?
    attr_reader rank: Integer?
  end

  class Dropped < ::Skyward::ORM::Record
    attr_reader id: Integer
    attr_reader owner_id: Integer
    attr_reader title: String
    attr_reader code: String
    attr_reader status: :open | :closed
    attr_reader rank: Integer?
