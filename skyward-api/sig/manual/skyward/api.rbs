class Skyward::API
  interface _RackApp
    def call: (Hash[String, untyped] env) -> rack_response
  end

  interface _Middleware
    def new: (_RackApp app, *untyped, **untyped) ?{ (?) -> untyped } -> _RackApp
  end

  interface _Logger
    def info: (String message) -> void
  end

  interface _Provider
    def call: (Skyward::Request request) -> untyped
  end

  interface _OnError
    def call: (StandardError exception, Hash[String, untyped] env) -> void
  end
end
