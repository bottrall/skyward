module BootFixtures
  class Todo
    attr_reader id: Integer
    attr_reader title: String
  end

  # Declares no password_hash, so it's never written.
  class User
    attr_reader id: Integer
    attr_reader name: String
  end

  class Draft
    attr_reader title: String
    attr_reader priority: :low | :high
    attr_reader due_on: Date?
  end

  class Holder
    attr_reader tags: Hash[Symbol, untyped]
  end

  class Listing
    attr_reader title: Strng
  end

  class Node
    attr_reader next: Node?
  end

  class Hello < Skyward::API
    def greet: (name: String) -> { message: String }
  end

  class Failing < Skyward::API
    def fail: () -> untyped
  end

  class Todos < Skyward::API
    def index: (?done: bool?, ?tags: Array[:low | :high]) -> Array[Todo]
    def show: (id: Integer) -> (Todo | :gone)
    def create: (body: { title: String }) -> Todo
    # Wrapped, as a signature file can be.
    def destroy: (id: Integer)
               -> (Todo | :gone)?
  end

  class NewForm < Skyward::API
    def new_form: () -> { title: String }
  end

  class StaticFirst < Skyward::API
    def new_form: () -> { title: String }
    def show: (id: Integer) -> Todo
  end

  class RootLast < Skyward::API
    def show: (id: Integer) -> Todo
    def index: () -> Array[Todo]
  end

  class StaticLast < Skyward::API
    def show: (id: Integer) -> Todo
    def new_form: () -> { title: String }
  end

  class SameShape < Skyward::API
    def show: (id: Integer) -> Todo
    def find: (todo_id: Integer) -> Todo
  end

  class Summarised < Skyward::API
    def index: () -> Array[Todo]
  end

  class UnsignedMethod < Skyward::API
  end

  # What rbs-inline writes for a method with no annotations.
  class Inlined < Skyward::API
    def greet: (name: untyped, ?shout: untyped, ?request: untyped) -> untyped
  end

  class UntypedKeyword < Skyward::API
    def show: (id: untyped) -> Todo
  end

  class NullableUntypedKeyword < Skyward::API
    def index: (?limit: untyped?) -> Todo
  end

  class NestedUntyped < Skyward::API
    def index: (?tags: Array[untyped]) -> Array[untyped]
  end

  class Positional < Skyward::API
    def show: (Integer id) -> Todo
  end

  class KeywordRest < Skyward::API
    def index: (**String filters) -> Array[Todo]
  end

  class Renamed < Skyward::API
    def index: (count: Integer) -> Array[Todo]
  end

  class MadeOptional < Skyward::API
    def index: (limit: Integer) -> Array[Todo]
  end

  class SignedPositionally < Skyward::API
    def show: (Integer id) -> Todo
  end

  class SignedUntyped < Skyward::API
    def show: (?) -> Todo
  end

  class Unnamed < Skyward::API
    def show: (todo_id: Integer) -> Todo
  end

  class MisspeltSignature < Skyward::API
    def show: (id: Integr) -> Todo
  end

  class TupleQuery < Skyward::API
    def index: (range: [Integer, Integer]) -> Array[Todo]
  end

  class MisspeltBody < Skyward::API
    def create: (body: Listing) -> Todo
  end

  class HashBody < Skyward::API
    def create: (body: Holder) -> Todo
  end

  class ArrayPath < Skyward::API
    def show: (ids: Array[Integer]) -> Array[Todo]
  end

  class ClassPath < Skyward::API
    def show: (todo: Todo) -> Todo
  end

  class HashPath < Skyward::API
    def show: (scores: Hash[String, Integer]) -> Array[Todo]
  end

  class RecordQuery < Skyward::API
    def index: (filter: { done: bool }) -> Array[Todo]
  end

  class HashQuery < Skyward::API
    def index: (?scores: Hash[String, Integer]?) -> Array[Todo]
  end

  class NullableClassQuery < Skyward::API
    def index: (?like: Todo?) -> Array[Todo]
  end

  class UnionQuery < Skyward::API
    def index: (near: Integer | Todo) -> Array[Todo]
  end

  class NestedArrayQuery < Skyward::API
    def index: (grid: Array[Array[Integer]]) -> Array[Todo]
  end

  class Requesting < Skyward::API
    def index: (request: Skyward::API::Request) -> { authorization: String?, session: String?, ip: String?, request_id: String }
    def show: (id: Integer, ?request: Skyward::API::Request) -> Todo
  end

  class MistypedRequest < Skyward::API
    def index: (request: String) -> Array[Todo]
  end

  class HashReturn < Skyward::API
    def index: () -> Hash[Symbol, untyped]
  end

  class SelfReferring < Skyward::API
    def index: () -> Node
  end

  class Responding < Skyward::API
    def show: (id: Integer) -> (Todo | Skyward::API::Responses::NotFound)
    def user: (id: Integer) -> User
    def misfit: (id: Integer) -> Todo
    def create: (body: { title: String }) -> Skyward::API::Responses::Created[Todo]
    def destroy: (id: Integer) -> (Skyward::API::Responses::NoContent | Skyward::API::Responses::Conflict | Skyward::API::Responses::Unprocessable)?
  end

  class Racking < Skyward::API
    def stream: () -> Skyward::API::rack
    def letters: () -> Array[String]
    def written: () -> [Integer, Hash[String, String], untyped]
    def download: (id: Integer) -> (Todo | Skyward::API::Responses::NotFound | Skyward::API::rack)
  end

  class Documented < Skyward::API
    def index: (?done: bool?, ?tags: Array[String], ?since: Time?) -> Array[{ id: Integer, title: String, ?note: String? }]
    def show: (id: Integer) -> (Todo | Skyward::API::Responses::NotFound)
    def create: (body: Draft) -> (Skyward::API::Responses::Created[Draft] | Skyward::API::Responses::Unprocessable)
    def destroy: (id: Integer) -> (Skyward::API::Responses::NoContent | Skyward::API::Responses::NotFound)
    def moved: (id: Integer) -> Skyward::API::Responses::Redirect
    def export: (id: Integer) -> (Skyward::API::rack | Skyward::API::Responses::NotFound)
  end

  class CreatedHash < Skyward::API
    def create: () -> Skyward::API::Responses::Created[Hash[Symbol, untyped]]
  end

  class CreatedBare < Skyward::API
    def create: () -> Skyward::API::Responses::Created
  end

  class CurrentUser
    def call: (Skyward::API::Request request) -> (User | Skyward::API::Responses::Unauthorized)
  end

  class Sessions
    def user_for: (Skyward::API::Request request) -> (User | Skyward::API::Responses::Unauthorized)
  end

  class Visitor
    def call: (Skyward::API::Request request) -> (User | Todo | Skyward::API::Responses::Unauthorized)?
  end

  class Guard
    def call: (Skyward::API::Request request) -> Skyward::API::Responses::Forbidden
  end

  class Authenticated < Skyward::API
    def me: (current_user: User) -> User
    def index: (tenant: String, current_user: User, ?limit: Integer) -> Array[Todo]
  end

  class Visiting < Skyward::API
    def index: (visitor: (Todo | User)?) -> Array[Todo | User]
  end

  class MistypedUser < Skyward::API
    def index: (current_user: Todo) -> Array[Todo]
  end

  class Guarded < Skyward::API
    def index: (admin: User) -> Array[User]
  end

  class ProvidedPath < Skyward::API
    def show: (current_user: String) -> Todo
  end

  class UntypedProvided < Skyward::API
    def index: (current_user: untyped, visitor: untyped?) -> Array[Todo]
  end
end
