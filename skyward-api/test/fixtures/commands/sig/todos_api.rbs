use Skyward::API::*

class Todo
  attr_reader id: Integer
  attr_reader title: String
  attr_reader priority: :low | :normal | :high
  attr_reader due_on: Date?
  attr_reader done: bool
end

class NewTodo
  attr_reader title: String
  attr_reader priority: :low | :normal | :high
  attr_reader due_on: Date?
end

class TodoStore
end

class TodosAPI < Skyward::API
  @todos: TodoStore

  def initialize: (todos: TodoStore) -> void

  def index: (?done: bool?, ?limit: Integer) -> Array[Todo]

  def show: (id: Integer) -> (Todo | Responses::NotFound)

  def create: (body: NewTodo) -> Responses::Created[Todo]

  def complete: (id: Integer) -> (Todo | Responses::NotFound)

  def destroy: (id: Integer) -> (Responses::NoContent | Responses::NotFound)
end
