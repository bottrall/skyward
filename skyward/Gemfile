# frozen_string_literal: true

source 'https://rubygems.org'

# Only this gem and the Skyward gems it depends on, so a test that reaches
# for any other fails here.
gemspec

gem 'skyward-api', path: '../skyward-api'
gem 'skyward-core', path: '../skyward-core'
gem 'skyward-orm', path: '../skyward-orm'

gem 'minitest', '~> 6.0'
gem 'rake', '~> 13.4'

# Test-only, so the tests that hold the API and the ORM to one reading of each
# type run on both databases. An app adds the driver it uses to its own Gemfile.
gem 'pg', '~> 1.7'
gem 'sqlite3', '~> 2.10'
