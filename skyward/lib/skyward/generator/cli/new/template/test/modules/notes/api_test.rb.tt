# frozen_string_literal: true

require "test_helper"

describe Notes::API do
  let(:api) { Notes::API.new(notes: Notes::Record) }

  def write(title = "Ship it") = Notes::Record.into(Notes::Record).insert!(title:, body: nil)

  describe "#index" do
    it "lists the newest note first" do
      %w[First Second].each { |title| write(title) }

      assert_equal %w[Second First], api.index.map(&:title)
    end

    it "lists at most limit notes" do
      %w[First Second].each { |title| write(title) }

      assert_equal %w[Second], api.index(limit: 1).map(&:title)
    end
  end

  describe "#show" do
    it "answers the note" do
      note = write

      assert_equal note, api.show(id: note.id)
    end

    it "answers 404 for a note that doesn't exist" do
      assert_instance_of Skyward::API::Responses::NotFound, api.show(id: 0)
    end
  end

  describe "#create" do
    it "answers the new note, created" do
      response = api.create(body: Notes::API::NewNote.new(title: "Buy milk", body: "Today"))

      assert_instance_of Skyward::API::Responses::Created, response
      assert_equal({ title: "Buy milk", body: "Today" }, response.value.to_h.except(:id))
    end

    it "keeps the new note" do
      note = api.create(body: Notes::API::NewNote.new(title: "Ship it", body: "Today")).value

      assert_equal Notes::Record.find_by(id: note.id), note
    end

    it "answers 422 for a title that's empty" do
      response = api.create(body: Notes::API::NewNote.new(title: "", body: nil))

      assert_instance_of Skyward::API::Responses::Unprocessable, response
    end
  end
end
