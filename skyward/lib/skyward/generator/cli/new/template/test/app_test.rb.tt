# frozen_string_literal: true

require "test_helper"

describe "App" do
  let(:client) { Skyward::API::Test.client(App) }

  describe "GET /notes" do
    it "mounts the notes API" do
      assert_equal [], client.get("/notes").json
    end
  end

  describe "GET /openapi.json" do
    it "documents every endpoint" do
      paths = client.get("/openapi.json").json[:paths].keys

      assert_equal %i[/notes /notes/{id}], paths
    end
  end

  describe "GET /docs" do
    it "serves the API reference" do
      assert_includes client.get("/docs").body, "<title>{{title}}</title>"
    end
  end
end
